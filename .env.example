# Copy to .env (repo root, used by Hardhat) and backend/.env (used by the API).
# Never commit real values. Use TEST wallets with testnet funds only.

# --- Blockchain (Polygon Amoy, chain ID 80002) ---
# The official https://rpc-amoy.polygon.technology is often down; backup: https://polygon-amoy.drpc.org
RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Wallet that deploys the contract and becomes DEFAULT_ADMIN
DEPLOYER_PRIVATE_KEY=
# Backend signing wallet; gets RELAYER_ROLE at deploy. Defaults to the deployer if empty.
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=
# Certifier's MetaMask wallet; gets CERTIFIER_ROLE at deploy (optional)
CERTIFIER_ADDRESS=
CONTRACT_ADDRESS=
# Block the contract was deployed in (deployments/amoy.json "deployBlock"); the indexer starts here
DEPLOY_BLOCK=0
# Amoy rejects priority fees below 25 gwei. Set 0 for a local Hardhat node.
MIN_PRIORITY_FEE_GWEI=30
# Cap on the tip (nodes often suggest ~56 gwei though Amoy's base fee is ~0)
MAX_PRIORITY_FEE_GWEI=40
TX_TIMEOUT_MS=90000
EXPLORER_URL=https://amoy.polygonscan.com
INDEXER_POLL_MS=5000
INDEXER_CONFIRMATIONS=2
INDEXER_BLOCK_CHUNK=1000
# For "npx hardhat verify" on the Amoy explorer (Etherscan v2 multichain key)
POLYGONSCAN_API_KEY=

# --- Database (Supabase PostgreSQL, "Session pooler" connection string) ---
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- IPFS ---
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# --- API ---
# Set to production on the live server: enables Secure cookies and checks NEXT_PUBLIC_SITE_URL
NODE_ENV=development
PORT=4000
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=7200
# Public site URL (https://your-domain in production). Used for CORS and printed in every QR code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Proxy hops before the API. 1 = visitor -> reverse proxy -> Next.js -> API (the normal setup).
# Keep the API port private (only Next.js should reach it).
TRUST_PROXY=1
# Rate limits per visitor IP
TRACE_RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=10

# --- Frontend (frontend/.env or the web container) ---
# Where the Next.js server reaches the API (internal address in production)
API_URL=http://localhost:4000

# --- Seeding (npm run db:seed in backend/) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# If set, creates one approved demo user per role (farmer@demo.local, ...)
DEMO_PASSWORD=
